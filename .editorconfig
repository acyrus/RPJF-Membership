# Keeps every editor consistent so files don't churn on line endings or indentation.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Markdown keeps trailing spaces (they can be meaningful line breaks).
[*.md]
trim_trailing_whitespace = false
